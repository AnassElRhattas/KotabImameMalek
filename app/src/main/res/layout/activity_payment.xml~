<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar avec un style moderne -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:contentScrim="@color/purple_800">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المبلغ المستحق"
                        android:textColor="@color/white"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 درهم"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الرسوم الشهرية - شهر يناير"
                        android:textColor="@color/white"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:layout_collapseMode="pin"
                    app:title="الدفع"
                    app:titleTextColor="@color/white"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Contenu principal avec effet d'élévation -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="24dp">

                <!-- Carte bancaire avec animation -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/gradient_card_background">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_stripe_logo"
                            android:layout_gravity="end"/>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/cardNumberPreview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="**** **** **** ****"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:letterSpacing="0.1"
                            android:fontFamily="monospace"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:id="@+id/cardHolderPreview"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="حامل البطاقة"
                                android:textColor="@color/white"/>

                            <TextView
                                android:id="@+id/cardExpiryPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MM/YY"
                                android:textColor="@color/white"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Champs de saisie avec style amélioré -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/purple_800"
                    app:hintTextColor="@color/purple_800"
                    android:textColorHint="#757575"
                    android:hint="رقم البطاقة"
                    app:startIconDrawable="@drawable/ic_credit_card"
                    app:startIconTint="@color/purple_800">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent"
                        android:textColor="#212121"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="16"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="@color/purple_800"
                    app:hintTextColor="@color/purple_800"
                    android:textColorHint="#757575"
                    android:hint="اسم حامل البطاقة"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/purple_800">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardHolder"
                        android:layout_width="match_parent"
                        android:textColor="#212121"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="@color/purple_800"
                        app:hintTextColor="@color/purple_800"
                        android:textColorHint="#757575"
                        android:hint="تاريخ الانتهاء"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="@color/purple_800">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="date"
                            android:textColor="#212121"
                            android:maxLength="5"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:boxStrokeColor="@color/purple_800"
                        app:hintTextColor="@color/purple_800"
                        android:textColorHint="#757575"
                        android:hint="CVC"
                        app:startIconDrawable="@drawable/ic_security"
                        app:startIconTint="@color/purple_800">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:textColor="#212121"
                            android:maxLength="3"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayNow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_margin="24dp"
                    android:backgroundTint="@color/purple_800"
                    android:elevation="8dp"
                    android:textColor="@color/white"
                    android:text="الدفع الآن"
                    android:textSize="18sp"
                    app:cornerRadius="23dp"
                    app:rippleColor="@color/white" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bouton de paiement avec effet d'élévation -->
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_user"
        app:menu="@menu/user_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
